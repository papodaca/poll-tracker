---
import { candidatesForRace, loadCandidates, loadPolls, pollsForRace } from '../data/queries.ts';
import { getRaces } from '../data/races.ts';
import { withBase } from '../data/site-path.ts';
import Sparkline from './Sparkline.astro';

interface Props {
	raceId: string;
}

const { raceId } = Astro.props;
const race = getRaces().find((item) => item.id === raceId);
if (!race) throw new Error(`Missing race ${raceId}`);

const candidates = candidatesForRace(loadCandidates(), race.id);
const polls = pollsForRace(loadPolls(), race.id);

function initials(name: string): string {
	const parts = name.split(/\s+/).filter(Boolean);
	if (parts.length === 0) return '';
	if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
	return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
}

function meta(poll: (typeof polls)[number]): string[] {
	const parts: string[] = [];
	if (poll.sponsor) parts.push(poll.sponsor);
	parts.push(`${poll.startDate} to ${poll.endDate}`);
	if (poll.sampleSize && poll.population) parts.push(`${poll.sampleSize} ${poll.population}`);
	else if (poll.sampleSize) parts.push(String(poll.sampleSize));
	else if (poll.population) parts.push(poll.population);
	if (poll.marginOfError) parts.push(`margin of error ${poll.marginOfError}`);
	return parts;
}
---

<h1>{race.title}</h1>

{
	candidates.length > 0 && (
		<ul class="candidates">
			{candidates.map((candidate) => (
				<li>
					{candidate.portrait ? (
						<img src={withBase(candidate.portrait)} alt="" width="64" height="64" />
					) : (
						<span class="initials" aria-hidden="true">
							{initials(candidate.name)}
						</span>
					)}
					<span>
						<span class="candidate-name">{candidate.name}</span>
						<span class="party">{candidate.party}</span>
					</span>
				</li>
			))}
		</ul>
	)
}

{polls.length > 0 ? <Sparkline candidates={candidates} polls={polls} /> : <p>No polls filed.</p>}

{
	polls.length > 0 && (
		<section>
			<h2>Polls</h2>
			{polls.map((poll) => (
				<article class="poll">
					<h3>{poll.pollster}</h3>
					{poll.sample && <p class="sample">Sample data</p>}
					<p class="poll-meta">
						{meta(poll).join(' · ')}
						{poll.url && (
							<>
								{' · '}
								<a href={poll.url}>Source</a>
							</>
						)}
					</p>
					<ul class="poll-results">
						{poll.results.map((result) => {
							const candidate = candidates.find((item) => item.id === result.candidateId);
							return (
								<li>
									{candidate?.name ?? result.candidateId} {result.percent}%
								</li>
							);
						})}
					</ul>
				</article>
			))}
		</section>
	)
}
