---
import '../styles/global.css';
import { crumbsForPath } from '../data/crumbs.ts';
import { withBase } from '../data/site-path.ts';

interface Props {
	title: string;
	wide?: boolean;
}

const { title, wide = false } = Astro.props;
const crumbs = crumbsForPath(Astro.url.pathname);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
		<link rel="icon" type="image/png" href={withBase('/favicon.png')} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav class:list={{ wide }} aria-label="Breadcrumb">
				<ol class="crumbs">
					{
						crumbs.map((crumb, index) => {
							const current = index === crumbs.length - 1;
							return (
								<li aria-current={current ? 'page' : undefined}>
									{index > 0 && (
										<span class="crumb-sep" aria-hidden="true">
											/
										</span>
									)}
									{current ? (
										<span class:list={['crumb-label', { brand: index === 0 }]}>
											{index === 0 && (
												<img class="brand-mark" src={withBase('/favicon.svg')} alt="" width="20" height="20" />
											)}
											{crumb.label}
										</span>
									) : (
										<a class:list={{ brand: index === 0 }} href={crumb.href}>
											{index === 0 && (
												<img class="brand-mark" src={withBase('/favicon.svg')} alt="" width="20" height="20" />
											)}
											{crumb.label}
										</a>
									)}
								</li>
							);
						})
					}
				</ol>
			</nav>
		</header>
		<main class:list={{ wide }}>
			<slot />
		</main>
	</body>
</html>
