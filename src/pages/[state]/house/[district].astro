---
import Base from '../../../layouts/Base.astro';
import RacePage from '../../../components/RacePage.astro';
import { getRaces } from '../../../data/races.ts';

export function getStaticPaths() {
	return getRaces()
		.filter((race) => race.office === 'house' && race.district !== null)
		.map((race) => ({
			params: { state: race.state, district: String(race.district) },
			props: { raceId: race.id },
		}));
}

const { raceId } = Astro.props;
const race = getRaces().find((item) => item.id === raceId);
---

<Base title={race?.title ?? 'House'}>
	<RacePage raceId={raceId} />
</Base>
