---
import Base from '../../../layouts/Base.astro';
import { getRaces } from '../../../data/races.ts';

export function getStaticPaths() {
	return getRaces()
		.filter((race) => race.office === 'senate' && race.seat)
		.map((race) => ({
			params: { state: race.state, seat: race.seat ?? '' },
			props: { title: race.title },
		}));
}

const { title } = Astro.props;
---

<Base title={title}>
	<h1>{title}</h1>
</Base>
