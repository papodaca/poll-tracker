---
import Base from '../layouts/Base.astro';
import UsMap from '../components/UsMap.astro';
import { loadPolls, pollCountByState } from '../data/queries.ts';
import { getRaces } from '../data/races.ts';

const races = getRaces();
const polls = loadPolls();
const raceStateById = new Map(races.map((race) => [race.id, race.state]));
const pollCounts = pollCountByState(polls, raceStateById);
---

<Base title="2026 polls" wide>
	<h1>2026 general election polls</h1>
	<p>Choose a state.</p>
	<UsMap pollCounts={pollCounts} />
</Base>
