{
  "name": "poll-tracker",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/check.ts",
    "fetch": "concurrently 'npm run fetch-hill' 'npm run fetch-rtwh' 'npm run fetch-fpo'",
    "fetch-hill": "node scripts/fetch-hill-polls.ts",
    "fetch-rtwh": "node scripts/fetch-rtwh-polls.ts",
    "fetch-fpo": "node scripts/fetch-fpo-polls.ts",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
